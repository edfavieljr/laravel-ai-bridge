# =============================================================================
# Laravel AI Bridge - Environment Configuration
# =============================================================================
# Copy this file to your project's .env and fill in your values.
# Only configure the providers you plan to use.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
AI_PROVIDER=openai
AI_CACHE_ENABLED=true
AI_CACHE_TTL=60
AI_FALLBACK_ENABLED=false
AI_LOGGING_ENABLED=true
AI_LOGGING_CHANNEL=stack
AI_RATE_LIMITING_ENABLED=true
AI_RATE_LIMIT=60
AI_STORAGE_ENABLED=false
AI_STORAGE_PURGE_AFTER=30

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_DEFAULT_IMAGE_MODEL=dall-e-3
OPENAI_TIMEOUT=30

# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_TIMEOUT=30

# -----------------------------------------------------------------------------
# Google Gemini
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
GEMINI_DEFAULT_EMBEDDING_MODEL=text-embedding-004
GEMINI_TIMEOUT=30

# -----------------------------------------------------------------------------
# HuggingFace
# -----------------------------------------------------------------------------
HUGGINGFACE_API_KEY=
HUGGINGFACE_DEFAULT_MODEL=gpt2
HUGGINGFACE_DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
HUGGINGFACE_TIMEOUT=30
