{
    "name": "edfavieljr/laravel-ai-bridge",
    "description": "LaravelAIBridge provides a unified and fluid API to implement advanced AI capabilities in Laravel applications, including text generation, embedding, sentiment analysis, classification and image generation, all following Laravel conventions and style.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Edfavieljr\\LaravelAIBridge\\": "src/"
        },
        "files": [
            "src/Helpers/ai_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Edfavieljr\\LaravelAIBridge\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Eduardo Faviel",
            "email": "edfaviel_jr@hotmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Edfavieljr\\LaravelAIBridge\\AIBridgeServiceProvider"
            ],
            "aliases": {
                "AI": "Edfavieljr\\LaravelAIBridge\\Facades\\AI",
                "OpenAI": "Edfavieljr\\LaravelAIBridge\\Facades\\OpenAI",
                "Anthropic": "Edfavieljr\\LaravelAIBridge\\Facades\\Anthropic",
                "Gemini": "Edfavieljr\\LaravelAIBridge\\Facades\\Gemini",
                "HuggingFace": "Edfavieljr\\LaravelAIBridge\\Facades\\HuggingFace"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
